│   │       │   ├── index.html
│   │       │   ├── create.html
│   │       │   └── edit.html
│   │       │
│   │       └── application.properties
│   │
│   └── test/
|
├── pom.xml
├── mvnw
├── mvnw.cmd
└── README.md
```

